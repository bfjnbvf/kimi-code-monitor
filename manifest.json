{
  "manifest_version": 3,
  "minimum_chrome_version": "120",
  "name": "Kimi Code Monitor",
  "version": "2.1.2",
  "author": "十叶",
  "description": "Kimi Code Web UI 底部 Agent 状态 HUD：额度、Token、缓存、性能一目了然",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_ui": {
    "page": "popup.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": [
        "http://127.0.0.1/*",
        "http://localhost/*"
      ],
      "js": [
        "rive/rive.js",
        "metrics.js",
        "cli-usage.js",
        "walkthrough.js",
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "rive/rive.wasm",
        "rive/kimi_avatar_default-srYjF2HV.riv",
        "rive/kimi_avatar_web-PnsTWI-X.riv"
      ],
      "matches": [
        "http://127.0.0.1/*",
        "http://localhost/*"
      ]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "host_permissions": [
    "https://api.kimi.com/*",
    "https://auth.kimi.com/*",
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "optional_host_permissions": [
    "https://api.deepseek.com/*",
    "https://api.moonshot.cn/*",
    "https://open.bigmodel.cn/*",
    "https://www.minimaxi.com/*"
  ],
  "permissions": [
    "storage",
    "alarms",
    "notifications",
    "declarativeNetRequestWithHostAccess"
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "kimi_csp_relax",
        "enabled": true,
        "path": "rules/csp_relax.json"
      }
    ]
  },
  "background": {
    "service_worker": "background.js"
  },
  "homepage_url": "https://github.com/bfjnbvf/kimi-code-monitor"
}
