{
  "name": "kimi-code-monitor",
  "version": "3.5.5",
  "private": true,
  "type": "module",
  "description": "Kimi Code Web UI 底部 Agent 状态 HUD 浏览器扩展",
  "scripts": {
    "hud:build": "node scripts/build-cli-hud.mjs",
    "hud:install": "node scripts/build-cli-hud.mjs && node scripts/install-cli-hud.mjs",
    "hud:test": "node scripts/build-cli-hud.mjs && node --test tests/cli-hud.test.js tests/cli-hud-quota.test.js tests/kap-auth.test.js",
    "hud:verify": "node scripts/build-cli-hud.mjs && node scripts/verify-cli-hud.mjs",
    "build": "node scripts/build.mjs",
    "pack": "bash scripts/build.sh",
    "lint": "eslint src/",
    "test": "node scripts/build.mjs && node --test",
    "pack:patch": "node scripts/build-patch.mjs"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "eslint": "^10.8.1",
    "jsdom": "^30.0.1"
  }
}
